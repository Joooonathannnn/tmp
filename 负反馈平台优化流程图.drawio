        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=13;fontColor=#667085;" value="从离线单机版到Tomcat共享服务版" vertex="1">
